    PUSHBUTTON "Test &1", psh1, 40, 50, 60, 15
    PUSHBUTTON "Test &2", psh2, 40, 70, 60, 15
    PUSHBUTTON "Test &3", psh3, 40, 90, 60, 15
}

IDD_ADDWORD DIALOG 46, 36, 172, 94
CAPTION "単語の登録"
STYLE WS_POPUPWINDOW | WS_CAPTION
FONT 10, "ＭＳ Ｐゴシック"
{
    LTEXT "よみがな(&R):", -1, 10, 7, 50, 10
    EDITTEXT edt2, 65, 5, 85, 15, ES_AUTOHSCROLL
    LTEXT "単語(&W):", -1, 10, 27, 50, 10
