    COMBOBOX cmb1, 65, 50, 85, 35, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "OK", IDOK, 55, 70, 60, 15
}

IDD_INPUTBOX DIALOG 0, 0, 215, 135
CAPTION "変換したい文字列を入力してください"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
