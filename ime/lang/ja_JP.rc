// RT_DIALOG

IDD_GENERAL DIALOG 0, 0, 185, 132
CAPTION "全般設定"
STYLE DS_NOIDLEMSG | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 10, "ＭＳ Ｐゴシック"
{
    AUTOCHECKBOX "「、」「。」の代わりに「，」「．」を使用する", chx1, 5, 5, 175, 15
    AUTOCHECKBOX "全角英数を使わない", chx2, 5, 25, 170, 15
    AUTOCHECKBOX "全角空白を禁止する", chx3, 5, 45, 170, 15
    AUTOCHECKBOX "全角カタカナを優先する", chx4, 5, 65, 170, 15
    AUTOCHECKBOX "半角カナを優先する", chx5, 5, 85, 170, 15
}

IDD_WORDLIST DIALOG 0, 0, 185, 132
CAPTION "ユーザー辞書"
STYLE DS_NOIDLEMSG | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 10, "ＭＳ Ｐゴシック"
{
    LTEXT "単語リスト(&L):", -1, 6, 5, 50, 10
    CONTROL "", lst1, "SysListView32", LVS_REPORT | WS_BORDER | WS_VSCROLL, 5, 18, 175, 68
    PUSHBUTTON "追加(&A)...", psh1, 40, 92, 60, 14
    PUSHBUTTON "削除(&R)...", psh2, 107, 92, 60, 14
}

IDD_CHOOSEDICT DIALOG 0, 0, 185, 132
CAPTION "辞書の選択"
STYLE WS_POPUPWINDOW | WS_CAPTION
FONT 10, "ＭＳ Ｐゴシック"
{
    LTEXT "現在の辞書:", -1, 5, 15, 84, 8
    COMBOBOX cmb1, 5, 28, 175, 9, CBS_HASSTRINGS | CBS_AUTOHSCROLL | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "選択(&S)", psh1, 123, 43, 40, 14
}

IDD_ABOUTIME DIALOG 0, 0, 185, 132
CAPTION "このIMEについて"
STYLE DS_NOIDLEMSG | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
FONT 10, "ＭＳ Ｐゴシック"
{
    ICON 0, ico1, 8, 8, 0, 0
    LTEXT "MZ-IME日本語入力 (mzimeja)\nVersion 1.0.1.2\nby katahiromz", 109, 33, 8, 100, 30
}

IDD_DEBUG DIALOG 0, 0, 185, 132
CAPTION "デバッグ オプション"
